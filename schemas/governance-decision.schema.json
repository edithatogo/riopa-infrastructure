{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/riopa/schema/governance-decision/v1",
  "title": "RIOPA Governance Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "subject_id", "subject_kind", "classification", "outcome", "scope", "review", "evidence", "rationale"],
  "properties": {
    "decision_id": {"type": "string", "pattern": "^urn:riopa:governance-decision:[A-Za-z0-9._:-]+$"},
    "subject_id": {"type": "string", "minLength": 1},
    "subject_kind": {"type": "string", "enum": ["source", "artifact", "transformation", "model", "release"]},
    "classification": {"type": "string", "enum": ["public", "restricted", "sensitive", "controlled", "prohibited"]},
    "outcome": {"type": "string", "enum": ["allow", "allow-with-conditions", "metadata-only", "controlled-only", "withdraw", "superseded", "prohibited", "review-required"]},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "reviewed_at", "expires_at", "conflict_of_interest"],
      "properties": {
        "role": {"type": "string", "minLength": 3},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "conflict_of_interest": {"type": "boolean"},
        "reviewer_id": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "recorded_at": {"type": "string", "format": "date-time"},
    "conditions": {"type": "array", "items": {"type": "string"}},
    "rationale": {"type": "string", "minLength": 1},
    "successor_id": {"type": ["string", "null"]},
    "withdrawal_reference": {"type": ["string", "null"]}
  }
}
