{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/riopa/schema/quality-report/v1",
  "title": "RIOPA Quality Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "subject_id",
    "generated_at",
    "profile",
    "results",
    "overall_status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "report_id": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "profile": {
      "type": "string"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "result_id",
          "dimension",
          "metric",
          "method",
          "status"
        ],
        "properties": {
          "result_id": {
            "type": "string"
          },
          "dimension": {
            "type": "string",
            "enum": [
              "completeness",
              "validity",
              "logical-consistency",
              "positional-accuracy",
              "temporal-accuracy",
              "thematic-accuracy",
              "uniqueness",
              "lineage",
              "rights",
              "accessibility",
              "reproducibility",
              "other"
            ]
          },
          "metric": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "value": {},
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "threshold": {},
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "warn",
              "not-applicable",
              "not-assessed"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "warn",
        "incomplete"
      ]
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "result_id",
          "reason",
          "approved_by",
          "approved_at"
        ],
        "properties": {
          "result_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "approved_by": {
            "type": "string"
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
