{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:riopa:schema:archived-capture-view:1.1.0",
  "title": "Experimental archived capture view 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "source",
    "facets",
    "view_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "record_type": {
      "const": "archived_capture_view"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_id",
        "record",
        "record_sha256"
      ],
      "properties": {
        "capture_id": {
          "type": "string",
          "pattern": "^urn:riopa:capture:sha256:[0-9a-f]{64}$"
        },
        "record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "record": {
          "type": "object",
          "required": [
            "schema_version",
            "record_type",
            "source_id"
          ],
          "properties": {
            "schema_version": {
              "const": "1.0.0"
            },
            "record_type": {
              "const": "archived_http_capture"
            },
            "source_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "facets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quality": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "uri",
              "sha256"
            ],
            "properties": {
              "uri": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "source_rights": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "uri",
              "sha256"
            ],
            "properties": {
              "uri": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "view_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$comment": "Schema validation alone does not verify hashes or referenced evidence. recover_capture verifies source and view hashes. Native event schema remains unchanged."
}
