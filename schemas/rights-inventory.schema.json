{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/riopa/schema/rights-inventory/v1",
  "title": "RIOPA Rights Inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inventory_id",
    "subject_id",
    "generated_at",
    "sources",
    "publication_decision"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "inventory_id": {
      "type": "string",
      "minLength": 3
    },
    "subject_id": {
      "type": "string",
      "minLength": 3
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "licence_status",
          "redistribution_status",
          "reviewed_at",
          "evidence_refs"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "access_status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "open",
              "public",
              "registered",
              "licensed",
              "restricted",
              "unknown",
              null
            ]
          },
          "licence_status": {
            "type": "string",
            "enum": [
              "declared",
              "inferred-not-permitted",
              "not-found",
              "mixed",
              "unknown"
            ]
          },
          "licence": {
            "type": [
              "string",
              "null"
            ]
          },
          "spdx_or_uri": {
            "type": [
              "string",
              "null"
            ]
          },
          "redistribution_status": {
            "type": "string",
            "enum": [
              "open",
              "attribution-required",
              "share-alike",
              "metadata-only",
              "local-only",
              "prohibited",
              "review-required",
              "unknown"
            ]
          },
          "attribution": {
            "type": [
              "string",
              "null"
            ]
          },
          "restrictions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "governance_triggers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "reviewer": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          },
          "review_expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "publication_decision": {
      "type": "string",
      "enum": [
        "allowed",
        "allowed-with-attribution",
        "share-alike-required",
        "metadata-only",
        "local-only",
        "review-required",
        "prohibited",
        "mixed"
      ]
    },
    "decision_basis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
