{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "record_id", "source", "archive_validation", "qualification", "non_claims"],
  "properties": {
    "schema": {"const": "riopa.supermarket-archived-source-qualification.v1"},
    "record_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["source_id", "archive_revision", "payload_sha256", "archive_path"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "archive_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "archive_path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "archive_validation": {
      "type": "object",
      "required": ["status", "feature_count", "premise_type_matching_supermarket_case_insensitive", "matching_status_counts"],
      "properties": {
        "status": {"const": "captured-and-content-addressed"},
        "feature_count": {"type": "integer", "minimum": 1},
        "premise_type_matching_supermarket_case_insensitive": {"type": "integer", "minimum": 0},
        "matching_status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      },
      "additionalProperties": true
    },
    "qualification": {
      "type": "object",
      "required": ["status", "promotion_allowed"],
      "properties": {"status": {"type": "string"}, "promotion_allowed": {"const": false}},
      "additionalProperties": true
    },
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
