{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riopa.example/schemas/analysis-protocol.schema.json",
  "title": "RIOPA bounded analysis protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_id",
    "version",
    "scenario_id",
    "estimand",
    "parameters",
    "replication",
    "limitations",
    "operational_status"
  ],
  "properties": {
    "protocol_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "scenario_id": {"type": "string", "minLength": 1},
    "estimand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "population",
        "exposure",
        "comparison",
        "outcome",
        "time_horizon",
        "identification_assumptions"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "population": {"type": "string", "minLength": 1},
        "exposure": {"type": "string", "minLength": 1},
        "comparison": {"type": "string", "minLength": 1},
        "outcome": {"type": "string", "minLength": 1},
        "time_horizon": {"type": "string", "minLength": 1},
        "identification_assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "unit", "source", "evidence_reference"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "value": {"type": "number"},
          "unit": {"type": "string", "minLength": 1},
          "source": {"enum": ["assumed", "fitted", "external"]},
          "evidence_reference": {"type": ["string", "null"], "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"source": {"enum": ["fitted", "external"]}}},
            "then": {"properties": {"evidence_reference": {"type": "string", "minLength": 1}}}
          }
        ]
      }
    },
    "replication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "master_seed",
        "replications",
        "warm_up_customers",
        "confidence_level",
        "convergence_relative_half_width"
      ],
      "properties": {
        "master_seed": {"type": "integer"},
        "replications": {"type": "integer", "minimum": 1},
        "warm_up_customers": {"type": "integer", "minimum": 0},
        "confidence_level": {"const": 0.95},
        "convergence_relative_half_width": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "operational_status": {"const": "synthetic-non-operational"}
  }
}
