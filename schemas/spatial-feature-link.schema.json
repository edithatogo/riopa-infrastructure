{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/riopa/schema/spatial-feature-link/v1",
  "title": "RIOPA Spatial Feature to Rule Link v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "link_id",
    "feature_version_id",
    "provision_version_ids",
    "link_method",
    "confidence",
    "evidence_refs",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "link_id": {
      "type": "string"
    },
    "feature_version_id": {
      "type": "string"
    },
    "provision_version_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "link_method": {
      "type": "string",
      "enum": [
        "publisher-provided",
        "deterministic-identifier",
        "rule-based",
        "model-assisted",
        "manual",
        "unknown"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "review": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "reviewer": {
          "type": "string"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "decision": {
          "type": "string",
          "enum": [
            "accepted",
            "rejected",
            "uncertain"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
