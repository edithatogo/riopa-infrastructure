{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/riopa/schema/snapshot-manifest/v1",
  "title": "RIOPA Snapshot Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "snapshot_id",
    "snapshot_version",
    "title",
    "created_at",
    "sources",
    "artifacts",
    "transformations",
    "materializations",
    "quality_report",
    "rights_inventory",
    "conforms_to",
    "citation",
    "provenance_events",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "dataset_id": {
      "type": "string"
    },
    "snapshot_id": {
      "type": "string"
    },
    "snapshot_version": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spatial": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_time_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "valid_time_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "retrieval_time_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "retrieval_time_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_record",
          "capture_ids"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "source_record": {
            "type": "string"
          },
          "capture_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "attribution": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "transformations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "materializations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "quality_report": {
      "type": "string"
    },
    "rights_inventory": {
      "type": "string"
    },
    "governance_decision_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "methods_facts": {
      "type": [
        "string",
        "null"
      ]
    },
    "conforms_to": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 1
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creators",
        "publisher",
        "publication_year"
      ],
      "properties": {
        "creators": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "publisher": {
          "type": "string"
        },
        "publication_year": {
          "type": "integer",
          "minimum": 2000
        },
        "doi": {
          "type": [
            "string",
            "null"
          ]
        },
        "concept_doi": {
          "type": [
            "string",
            "null"
          ]
        },
        "repository": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "licence": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relation",
          "identifier"
        ],
        "properties": {
          "relation": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          },
          "identifier_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance_events": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "domain_records": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
