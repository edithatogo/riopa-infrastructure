{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/riopa/schema/transformation-run/v1",
  "title": "RIOPA Transformation Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_type",
    "status",
    "started_at",
    "ended_at",
    "implementation",
    "invocation",
    "inputs",
    "outputs",
    "determinism"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string"
    },
    "run_type": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "partial",
        "cancelled"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "commit": {
          "type": "string",
          "minLength": 7
        },
        "swhid": {
          "type": [
            "string",
            "null"
          ]
        },
        "package": {
          "type": [
            "string",
            "null"
          ]
        },
        "package_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "parameters"
      ],
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "parameters": {
          "type": "object"
        },
        "working_directory": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "container_image": {
          "type": [
            "string",
            "null"
          ]
        },
        "container_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "lockfile": {
          "type": [
            "string",
            "null"
          ]
        },
        "lockfile_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtime": {
          "type": [
            "string",
            "null"
          ]
        },
        "platform": {
          "type": [
            "string",
            "null"
          ]
        },
        "runner": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "classification_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class"
      ],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "deterministic-bytes",
            "deterministic-semantics",
            "seeded-stochastic",
            "non-deterministic",
            "unknown"
          ]
        },
        "random_seed": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "tolerance": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quality_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
