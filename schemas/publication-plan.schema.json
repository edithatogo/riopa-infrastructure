{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/riopa/schema/publication-plan/v1",
  "title": "RIOPA rights-aware publication plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "publication_id", "snapshot_id", "snapshot_version", "source_research_object", "policy", "targets", "assets", "status", "blockers", "plan_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "publication_plan"},
    "publication_id": {"type": "string", "format": "uri"},
    "snapshot_id": {"type": "string", "format": "uri"},
    "snapshot_version": {"type": "string", "minLength": 1},
    "source_research_object": {
      "type": "object", "additionalProperties": false,
      "required": ["bundle_manifest_sha256", "snapshot_manifest_sha256"],
      "properties": {
        "bundle_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "snapshot_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["fail_closed", "verified_research_object_required", "mutable_identifier_policy"],
      "properties": {
        "fail_closed": {"const": true},
        "verified_research_object_required": {"const": true},
        "mutable_identifier_policy": {"const": "record-after-publication"}
      }
    },
    "targets": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/target"}
    },
    "assets": {
      "type": "array",
      "items": {"$ref": "#/$defs/asset"}
    },
    "status": {"enum": ["ready", "review-required"]},
    "blockers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["target_id", "kind", "repository", "required", "environment", "identifier", "revision"],
      "properties": {
        "target_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "environment": {"type": "string", "minLength": 1},
        "identifier": {"type": ["string", "null"]},
        "revision": {"type": ["string", "null"]}
      }
    },
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["asset_id", "path", "sha256", "size_bytes", "media_type", "classification", "rights_decision", "source_ids", "target_ids", "decision_basis", "attribution"],
      "properties": {
        "asset_id": {"type": "string", "format": "uri"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "media_type": {"type": ["string", "null"]},
        "classification": {"type": "string", "minLength": 1},
        "rights_decision": {"enum": ["publish", "metadata-only", "local-only", "withhold", "review-required"]},
        "source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "target_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "decision_basis": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "attribution": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
