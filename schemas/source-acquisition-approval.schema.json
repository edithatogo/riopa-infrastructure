{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/riopa/schema/source-acquisition-approval/v1",
  "title": "RIOPA source acquisition approval v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "recipient", "source_revision", "rights_reference", "outcome", "scope", "exclusions", "conditions", "expires_at", "approved_by"],
  "properties": {
    "decision_id": {"type": "string", "minLength": 3},
    "recipient": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "rights_reference": {"type": "string", "minLength": 1},
    "outcome": {"type": "string", "enum": ["allow", "allow-with-conditions", "metadata-only", "review-required", "prohibited"]},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "exclusions": {"type": "array", "items": {"type": "string"}},
    "conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "expires_at": {"type": "string", "format": "date-time"},
    "approved_by": {"type": "string", "minLength": 1}
  },
  "not": {"anyOf": [{"required": ["password"]}, {"required": ["token"]}, {"required": ["secret"]}, {"required": ["credential"]}]}
}
