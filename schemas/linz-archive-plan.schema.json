{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/riopa/schema/linz-archive-plan/v1",
  "title": "LINZ catalogue-complete archive plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "plan_id",
    "catalog_snapshot_id",
    "catalog_items_sha256",
    "policy_id",
    "policy_version",
    "scope",
    "coverage",
    "dispositions",
    "plan_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_type": {
      "const": "linz_archive_plan"
    },
    "plan_id": {
      "type": "string",
      "format": "uri"
    },
    "catalog_snapshot_id": {
      "type": "string",
      "format": "uri"
    },
    "catalog_items_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_id": {
      "type": "string",
      "format": "uri"
    },
    "policy_version": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "catalogue_complete",
        "planning_inputs_complete",
        "payload_complete",
        "item_count",
        "unclassified_count"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "catalogue_complete": {
          "type": "boolean"
        },
        "payload_complete": {
          "type": "boolean"
        },
        "item_count": {
          "type": "integer",
          "minimum": 0
        },
        "unclassified_count": {
          "type": "integer",
          "minimum": 0
        },
        "planning_inputs_complete": {
          "type": "boolean"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by_strategy",
        "by_payload_status",
        "by_item_type",
        "by_tier"
      ],
      "properties": {
        "by_strategy": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_payload_status": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_item_type": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_tier": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "catalog_item_id",
          "source_catalog_id",
          "item_type",
          "name",
          "raw_sha256",
          "rule_id",
          "strategy",
          "tier",
          "priority",
          "cadence",
          "destinations",
          "rights_disposition",
          "estimated_size_bytes",
          "payload_status",
          "blockers",
          "job_key",
          "services",
          "url",
          "payload_methods",
          "format_profile",
          "format_preferences",
          "export_crs",
          "automatic_export_limit_bytes"
        ],
        "properties": {
          "catalog_item_id": {
            "type": "string",
            "format": "uri"
          },
          "source_catalog_id": {
            "type": [
              "string",
              "integer",
              "null"
            ]
          },
          "item_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {},
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "raw_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "strategy": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "type": "string",
            "pattern": "^T[1-4]$"
          },
          "priority": {
            "type": "string",
            "pattern": "^P[0-3]$"
          },
          "cadence": {
            "type": "string",
            "minLength": 1
          },
          "destinations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rights_disposition": {
            "type": "string",
            "minLength": 1
          },
          "estimated_size_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "payload_status": {
            "type": "string",
            "enum": [
              "ready",
              "review-required",
              "metadata-only",
              "archived",
              "failed",
              "deferred"
            ]
          },
          "blockers": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "job_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "services": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "payload_methods": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "format_profile": {
            "type": [
              "string",
              "null"
            ]
          },
          "format_preferences": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "export_crs": {
            "type": [
              "string",
              "null"
            ]
          },
          "automatic_export_limit_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        }
      }
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
