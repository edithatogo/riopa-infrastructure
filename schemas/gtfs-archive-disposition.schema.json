{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "record_id", "archive_repository", "archive_revision", "sources", "disposition", "non_claims"],
  "properties": {
    "schema": {"const": "riopa.gtfs-archive-disposition.v1"},
    "record_id": {"type": "string", "minLength": 1},
    "archive_repository": {"type": "string", "minLength": 1},
    "archive_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "manifest_path", "archive_status", "payload_present"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "manifest_path": {"type": "string", "minLength": 1},
          "archive_status": {"const": "unavailable"},
          "payload_present": {"const": false}
        },
        "additionalProperties": true
      }
    },
    "disposition": {
      "type": "object",
      "required": ["network_claims_enabled", "timetable_claims_enabled", "promotion_allowed"],
      "properties": {
        "network_claims_enabled": {"const": false},
        "timetable_claims_enabled": {"const": false},
        "promotion_allowed": {"const": false}
      },
      "additionalProperties": true
    },
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
