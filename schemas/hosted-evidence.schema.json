{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.riopa.example/hosted-evidence.schema.json",
  "title": "RIOPA hosted evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lane",
    "classification",
    "status",
    "command",
    "started_at",
    "ended_at",
    "exit_code",
    "source_revision",
    "host",
    "log",
    "non_claims"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0.0", "1.1.0"]},
    "campaign_id": {"type": "string", "minLength": 3},
    "qualification_epoch": {"type": "string", "minLength": 3},
    "operational_cycle_id": {"type": "string", "minLength": 3},
    "candidate_revision": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "lane": {
      "enum": [
        "recovery-rollback",
        "agent-clean-room",
        "scale-smoke",
        "operational-observation",
        "rc-soak-observation",
        "performance-rehearsal",
        "retrospective-replay"
      ]
    },
    "classification": {"enum": ["hosted-technical-preview-drill", "hosted-retrospective-supplement"]},
    "status": {"enum": ["passed", "failed"]},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "exit_code": {"type": "integer"},
    "source_revision": {
      "anyOf": [
        {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        {"const": "local-uncommitted"}
      ]
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "run_id", "run_attempt", "runner_name", "runner_os", "architecture"],
      "properties": {
        "provider": {"enum": ["github-actions", "local"]},
        "run_id": {"type": ["string", "null"]},
        "run_attempt": {"type": ["string", "null"]},
        "runner_name": {"type": "string"},
        "runner_os": {"type": "string"},
        "architecture": {"type": "string"}
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "non_claims": {"type": "array", "minItems": 4, "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.1.0"}}},
      "then": {
        "required": ["campaign_id", "qualification_epoch", "operational_cycle_id"]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": "1.1.0"},
          "lane": {"const": "rc-soak-observation"}
        }
      },
      "then": {
        "required": ["candidate_revision"],
        "properties": {
          "candidate_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        }
      }
    }
  ]
}
