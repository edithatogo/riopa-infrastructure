{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/riopa/schema/canonical-crosswalk/v1",
  "title": "RIOPA canonical crosswalk claim v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["mapping_id", "source_assertion", "canonical_id", "method", "confidence", "reviewer", "valid_time", "evidence"],
  "properties": {
    "mapping_id": {"type": "string", "pattern": "^urn:riopa:mapping:[A-Za-z0-9._:-]+$"},
    "source_assertion": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "label"],
      "properties": {"source_id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}}
    },
    "canonical_id": {"type": "string", "pattern": "^urn:riopa:[A-Za-z0-9._:-]+$"},
    "method": {"type": "string", "minLength": 1},
    "confidence": {"enum": ["unknown", "low", "medium", "high", "disputed", "inapplicable"]},
    "reviewer": {"type": "string", "minLength": 1},
    "valid_time": {
      "type": "object", "additionalProperties": false, "required": ["from", "to"],
      "properties": {"from": {"type": "string", "format": "date"}, "to": {"type": ["string", "null"], "format": "date"}}
    },
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
